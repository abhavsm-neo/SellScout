# ─── Database (Required) ───
# Option A: TiDB Cloud (Free tier - recommended)
# Sign up at https://tidbcloud.com/ → Create cluster → Get connection string
DATABASE_URL=mysql://user:password@host:4000/db?ssl={"rejectUnauthorized":true}

# Option B: PlanetScale (Free tier)
# DATABASE_URL=mysql://user:password@host.psdb.cloud/db?ssl={"rejectUnauthorized":true}

# Option C: Railway / Render / AWS RDS
# DATABASE_URL=mysql://user:password@host:3306/db

# ─── OAuth / Authentication (Optional - app works without login) ───
# Register your app at https://platform.kimi.ai/ → Applications
# Redirect URI must be: https://YOUR-APP.vercel.app/api/oauth/callback
VITE_APP_ID=your_kimi_app_id
VITE_APP_SECRET=your_kimi_app_secret
KIMI_AUTH_URL=https://platform.kimi.ai
REDIRECT_URI=https://your-app.vercel.app/api/oauth/callback

# ─── JWT Secret (Required if using auth) ───
# Generate a random string: openssl rand -base64 32
JWT_SECRET=your-random-jwt-secret-key-min-32-chars

# ─── API URL (Optional - for local dev) ───
API_URL=http://localhost:3000
